{
  "name": "agenetic-desktop",
  "version": "0.2.5",
  "description": "Agenetic by Groundplanes, a local research workspace",
  "author": "Groundplanes",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:unpacked": "electron-builder --dir --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.groundplanes.agenetic",
    "productName": "Agenetic",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "security.cjs",
      "renderer/**/*",
      "package.json",
      "updates.cjs"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LLAMA-LICENSE.txt",
        "to": "runtime/LLAMA-LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Agenetic-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "T6ck",
        "repo": "Agenetic-By-groundplanes",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
